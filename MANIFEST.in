# SPDX-License-Identifier: MPL-2.0
include .gitattributes README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md LICENSE THIRD_PARTY_NOTICES.md DEPENDENCIES.json REUSE.toml pyproject.toml requirements*.lock .gitignore
recursive-include src *
recursive-include tests *.py
recursive-include tests/fixtures *.etl *.md
recursive-include docs *
recursive-include examples *
recursive-include scripts *.py *.ps1
recursive-include tools *.c
recursive-include packaging *
recursive-include benchmarks *.py *.json *.md *.csv
recursive-include LICENSES *
recursive-include .github *.md *.yml *.yaml CODEOWNERS
prune .git
prune .venv
prune .worktrees
prune .artifacts
prune artifacts
prune build
prune dist
prune .pytest_cache
prune .ruff_cache
prune docs/verification
prune docs/mockups
prune docs/ux-guided-workflow
recursive-exclude * __pycache__ *.pyc *.pyo *.log *.tmp .coverage* coverage.json coverage.xml pytest-results.xml
recursive-exclude * AGENTS.md SKILL.md START_HERE.md *PROMPT*.md *HANDOFF*.md
