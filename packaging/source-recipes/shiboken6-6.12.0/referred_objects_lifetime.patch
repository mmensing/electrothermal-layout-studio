+static RefCountMap takeRefCountKey(SbkObject *self, const std::string &key)
+{
+    RefCountMap references;
+    if (auto *refCountMap = self->d->referredObjects) {
+        const auto iterPair = refCountMap->equal_range(key);
+        // Transfer the owned references out of the traversable map before any
+        // decref can run a finalizer, collect cycles or re-enter the binding.
+        references.insert(iterPair.first, iterPair.second);
+        refCountMap->erase(iterPair.first, iterPair.second);
+    }
+    return references;
